# ---------------------------------------------------------------------------
# Copy to .env and fill in. NEVER commit the real .env (it is gitignored).
# Variable names are case-sensitive on Linux hosts (Render/Docker) — use the
# exact uppercase spellings below.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=8000

# --- Database (Postgres; Neon/Supabase/local all work) ---
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
# Auto-detected from sslmode=require in the URL; set explicitly to override.
DATABASE_SSL=true
# Auto-creates tables from the entities. Defaults ON outside production.
# In production leave this false and use migrations — synchronize can DROP
# columns when an entity changes. Set true for ONE boot to create new tables.
#
# NOTE: adding a column (or a whole entity) means production needs one boot
# with DB_SYNC=true, or the API returns "column does not exist" for every
# query touching it. Turn it back off immediately afterwards.
DB_SYNC=false

# --- Auth ---
# Generate with: openssl rand -hex 64   (app refuses to boot without it)
JWT_SECRET=
# Separate secret for refresh tokens so a leaked access secret cannot mint
# long-lived refreshes. Falls back to "<JWT_SECRET>-refresh" if unset.
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- CORS ---
# Comma-separated allowlist of frontend origins. REQUIRED in production —
# the app refuses to start without it rather than allowing every origin.
# Use the deployed frontend's ORIGIN, with no trailing slash and no path:
#   CORS_ORIGINS=https://hck-main-frontend-omega.vercel.app
# Vercel preview deployments get their own hostnames; add them too if you
# need previews to talk to this API.
CORS_ORIGINS=http://localhost:3000

# --- ML inference service ---
ML_SERVICE_URL=http://localhost:9000
# MUST be generous. A free-tier Render instance takes 30-60s to wake from
# sleep — a measured cold start was 31.5s — so anything near 5000 makes the
# first upload after an idle period fail every time, even with a healthy
# service and a loaded model.
ML_SERVICE_TIMEOUT_MS=60000

# --- Media storage (Cloudinary) ---
# Uploads are rejected outright when these are missing: MlController stores
# the image before calling the model, so ingest fails at the storage step.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Demo data ---
# OFF by default, and should stay off anywhere the data is read as real.
# When true AND the structures table is empty, SeedService inserts five
# FICTIONAL San Francisco structures with invented detections whose images
# point at /mock/*.jpg paths that do not exist. Useful for a demo; dangerous
# anywhere someone might mistake it for monitoring data.
SEED_DEMO_DATA=false

# --- First-admin bootstrap (remove after the account exists) ---
# Signup always creates an "inspector" and ignores any role in the request
# body, so this is the only path to the first admin. Runs once, only when no
# admin exists yet. Password must be at least 12 characters.
#
# You need this: registering a structure requires the engineer or admin role,
# so without an admin nobody can add anything to the map. Once the account
# exists, sign in as it and promote your real accounts from /admin, then
# delete these two vars.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
