# ---------------------------------------------------------------------------
# Copy to .env and fill in. NEVER commit the real .env (it is gitignored).
# Variable names are case-sensitive on Linux hosts (Render/Docker) — use the
# exact uppercase spellings below.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=8000

# --- Database (Postgres; Neon/Supabase/local all work) ---
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
# Auto-detected from sslmode=require in the URL; set explicitly to override.
DATABASE_SSL=true
# Auto-creates tables from the entities. Defaults ON outside production.
# In production leave this false and use migrations — synchronize can DROP
# columns when an entity changes. Set true for ONE boot to create new tables.
DB_SYNC=false

# --- Auth ---
# Generate with: openssl rand -hex 64   (app refuses to boot without it)
JWT_SECRET=
# Separate secret for refresh tokens so a leaked access secret cannot mint
# long-lived refreshes. Falls back to "<JWT_SECRET>-refresh" if unset.
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- CORS ---
# Comma-separated allowlist of frontend origins. REQUIRED in production —
# the app refuses to start without it rather than allowing every origin.
CORS_ORIGINS=http://localhost:3000

# --- ML inference service ---
ML_SERVICE_URL=http://localhost:9000
ML_SERVICE_TIMEOUT_MS=5000

# --- Media storage (Cloudinary) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
